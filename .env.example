# ===================================================================
# Library Management Platform - Environment Variables
# ===================================================================
# INSTRUCTIONS:
# 1. Paste your MongoDB Atlas connection string below into MONGODB_URI.
# 2. Make sure you replace <username> and <password> with your database user credentials.
# 3. Ensure the database name (/library_db) is included before the query parameters.
# 4. NEVER commit your actual .env file with real credentials to GitHub.
# ===================================================================

# MongoDB Atlas Connection URL
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/library_db?retryWrites=true&w=majority
MONGODB_URI=

# Port for Backend Server (default: 8081)
PORT=8081

# JWT Secret Key (default provided in application.properties)
# APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ===================================================================
# Mail Configuration (For Forgot Password & Email Notifications)
# ===================================================================
# For Gmail:
# 1. Enable 2-Step Verification in Google Account (https://myaccount.google.com/security)
# 2. Generate a 16-character App Password (https://myaccount.google.com/apppasswords)
# 3. Paste your email in MAIL_USERNAME and the 16-character App Password in MAIL_PASSWORD
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend Client URL (used for password reset links sent via email)
CLIENT_URL=http://localhost:3000
